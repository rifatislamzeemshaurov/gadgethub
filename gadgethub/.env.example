# =============================================================================
# GadgetHub - environment configuration
# =============================================================================
# Single source of truth for local development, catalog ingestion, and AWS
# deployment. Read by:
#   - backend/            (python-dotenv, local runs)
#   - ingestion/          (rag_pipeline.ipynb)
#   - scripts/deploy.*    and scripts/destroy.*
#
# Copy this file to .env and fill in the values. Never commit .env.
# Format: plain KEY=value, no quotes, no spaces around "=".
# =============================================================================

# --- AWS account -------------------------------------------------------------
# Credentials the deploy/destroy scripts use for Terraform, the AWS CLI and
# ECR. Leave the two key fields empty to fall back to your "aws configure"
# profile instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Safety check: deployment aborts if the credentials above belong to a
# different account.
AWS_ACCOUNT_ID=

# --- Project -----------------------------------------------------------------
# Name prefix for every AWS resource: <PROJECT_NAME>-<environment>-*
# Lowercase letters, numbers and hyphens only.
PROJECT_NAME=gadgethub

# --- Custom domain -----------------------------------------------------------
# When USE_CUSTOM_DOMAIN=true the app is served at
# https://<APP_SUBDOMAIN>.<DOMAIN_NAME>. DOMAIN_NAME must already be a
# Route 53 hosted zone in the AWS account above. Set to false to serve the app
# on the default CloudFront domain.
USE_CUSTOM_DOMAIN=false
DOMAIN_NAME=example.com
APP_SUBDOMAIN=app

# --- Backend compute (ECS Fargate) -------------------------------------------
# CONTAINER_CPU is in CPU units (256 = 0.25 vCPU), CONTAINER_MEMORY in MiB.
CONTAINER_CPU=256
CONTAINER_MEMORY=512
DESIRED_COUNT=1

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Qdrant Cloud ------------------------------------------------------------
# Cluster holding the "gadgethub-catalog-openai-qdrant" collection.
QDRANT_URL=
QDRANT_API_KEY=

# --- API access --------------------------------------------------------------
# Shared secret the frontend sends as the X-API-Key header on every request.
# Must match NEXT_PUBLIC_API_KEY in frontend/.env.development.
API_KEY_UI=
# Allowed browser origins for local runs (comma-separated). In AWS this is set
# automatically to the deployed domain.
CORS_ORIGINS=http://localhost:3000

# --- Conversation memory (local runs) ----------------------------------------
# In AWS, USE_S3 and S3_BUCKET are set automatically by Terraform.
USE_S3=false
S3_BUCKET=
MEMORY_DIR=../memory
