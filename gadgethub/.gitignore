# Secrets - the single .env at the project root (see .env.example)
.env

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/

# Memory files (local conversation history)
memory/*.json

# RAGWire logs and ingestion source PDFs — not source code, don't belong in git
backend/.log/
ingestion/.log/
data/
data/_staged_products/

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate.d/
*.tfstate
*.tfstate.*
*.tfvars

# Frontend production env file generated by the deploy scripts
frontend/.env.production

# Local tooling files
frontend/AGENTS.md
frontend/CLAUDE.md
